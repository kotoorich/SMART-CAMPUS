# Local development only. Copy this file to backend/.env.
# Demo records and sample accounts are created only on your own computer.
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local Supabase Storage configuration.
# If omitted locally, photos are stored in backend/private_uploads/attendance.
# In Render these values are REQUIRED; do not use ephemeral local storage.
# Create a PRIVATE bucket named attendance-selfies in Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attendance-selfies
STORAGE_BACKEND=local
