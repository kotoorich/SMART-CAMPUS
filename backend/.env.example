# LOCAL DEVELOPMENT ONLY
# Do not use these demo credentials in production.
ENVIRONMENT=development
SEED_DEMO_DATA=true
APP_TIMEZONE=Africa/Accra
INSTITUTION_NAME=Smart Campus

# Leave DATABASE_URL unset for the default local SQLite database:
# backend/smart_campus.db
# For a local PostgreSQL instance, uncomment and set your own URL.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_campus

# Local demo accounts (created/updated only when SEED_DEMO_DATA=true
# and ENVIRONMENT is not production).
DEMO_ADMIN_NAME=Evelyn Owusu
DEMO_ADMIN_EMAIL=admin@smartcampus.com
DEMO_ADMIN_PASSWORD=Admin@12345

DEMO_FACULTY_NAME=Daniel Mensah
DEMO_FACULTY_EMAIL=faculty1@smartcampus.com
DEMO_FACULTY_PASSWORD=Lecturer@12345

DEMO_STUDENT_NAME=Ama Serwaa
DEMO_STUDENT_EMAIL=student@smartcampus.com
DEMO_STUDENT_PASSWORD=Student@12345
DEMO_STUDENT_INDEX_NUMBER=2024001
DEMO_DEPARTMENT=CSE(AI&DS)

# Local frontend origins. Add other local origins only when needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Attendance settings (metres).
ATTENDANCE_GPS_RADIUS_METERS=50
ATTENDANCE_GPS_ACCURACY_CEILING=500
ATTENDANCE_GPS_SESSION_ACCURACY_CEILING=500

# Optional: set a stable local key if you want sessions to survive
# backend restarts on another machine. If omitted, a local key is generated.
# JWT_SECRET_KEY=replace-with-a-long-random-local-secret
